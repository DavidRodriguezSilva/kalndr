---
import Base from "@/layouts/Base.astro";
import Calendario from "@/components/Calendario";
import ProximoFestivo from "@/components/ProximoFestivo";
import Ciclicas from "@/components/Ciclicas";
import {
  ANIO_MAXIMO_CALCULABLE,
  ANIO_REGIMEN_ACTUAL,
  anioActual,
  calcularFestivos,
  coincidencias,
  diasNoLaborables,
} from "@/domain/festivos";
import { SITIO, ruta } from "@/seo/sitio";
import { conjuntoDeDatos, listaFestivos, preguntas, sitioWeb } from "@/seo/jsonld";

const anio = anioActual();
const festivos = calcularFestivos(anio);
const dias = diasNoLaborables(anio);
const juntos = coincidencias(anio);
const puentes = festivos.filter((f) => new Date(`${f.fecha}T00:00:00Z`).getUTCDay() === 1);

const hoy = new Intl.DateTimeFormat("en-CA", {
  timeZone: SITIO.zona,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());

const faq = [
  {
    pregunta: `¿Cuántos festivos tiene Colombia en ${anio}?`,
    respuesta: `${anio} tiene ${festivos.length} festivos nacionales${
      juntos.length > 0
        ? `, pero solo ${dias.length} días de descanso: dos celebraciones caen el mismo día.`
        : "."
    }`,
  },
  {
    pregunta: "¿Por qué algunos festivos se corren al lunes?",
    respuesta:
      "Por la Ley 51 de 1983, conocida como Ley Emiliani. Siete festivos de fecha fija se trasladan al lunes siguiente cuando no caen en lunes, para formar un puente. Los demás se celebran el día que les corresponde.",
  },
  {
    pregunta: "¿Qué festivos cambian de fecha cada año?",
    respuesta:
      "Los cinco que dependen del Domingo de Pascua: Jueves Santo, Viernes Santo, la Ascensión del Señor, Corpus Christi y el Sagrado Corazón de Jesús. Los tres últimos, además, siempre caen en lunes.",
  },
  {
    pregunta: "¿Cuál es el festivo nuevo de Colombia?",
    respuesta:
      "La Virgen del Rosario de Chiquinquirá, el 9 de julio, añadida por la Ley 2578 de 2026 y trasladable al lunes siguiente. Desde 2026 Colombia pasó de 18 a 19 festivos.",
  },
];
---

<Base
  titulo={`Festivos de Colombia ${anio} — calendario completo | ${SITIO.nombre}`}
  descripcion={`Los ${festivos.length} festivos de Colombia en ${anio}, con fechas exactas, cuáles se trasladan al lunes y cuándo cae el próximo. Calendario, API y suscripción.`}
  camino="/"
  tarjeta="inicio"
  datos={[sitioWeb(), listaFestivos(anio, festivos), preguntas(faq), conjuntoDeDatos()]}
>
  <div class="py-10 sm:py-14">
    <!-- Arriba, alineados por la cabeza. Antes iban alineados por el pie y
         el título quedaba empujado hacia abajo sin razón. -->
    <!-- Las dos columnas crecen igual: el bloque de texto y la tarjeta
         comparten alto para que la fila se lea como una sola pieza. -->
    <div class="grid items-stretch gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
      <div class="flex flex-col justify-center">
        <h1 class="text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
          Festivos Colombia <span class="text-primary">{anio}</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Pocos países del mundo descansan tanto. {festivos.length} festivos, {puentes.length} de ellos
          en lunes: {puentes.length} fines de semana de tres días sin pedir un solo día de vacaciones.
        </p>
      </div>

      <ProximoFestivo client:load fechaBuild={hoy} />
    </div>

    <div class="mt-14">
      <Calendario
        client:load
        anioInicial={anio}
        anioMinimo={ANIO_REGIMEN_ACTUAL}
        anioMaximo={ANIO_MAXIMO_CALCULABLE}
        hoy={hoy}
      />
    </div>

    <!-- No son festivos ni dan el día libre, pero son las fechas que la gente
         lleva en la cabeza, y este sitio ya sabe contar días. -->
    <section class="mt-20" aria-labelledby="cuenta-atras">
      <h2 id="cuenta-atras" class="text-2xl font-semibold tracking-tight">Cuenta atrás</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Las citas que vuelven cada cuatro años, para las que sí se planea con tiempo.
      </p>
      <div class="mt-6">
        <Ciclicas client:load hoy={hoy} />
      </div>
    </section>

    <section class="mt-20" aria-labelledby="faq">
      <h2 id="faq" class="text-2xl font-semibold tracking-tight">Preguntas frecuentes</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          faq.map((p) => (
            <div class="rounded-lg border border-border p-5">
              <dt class="font-medium">{p.pregunta}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.respuesta}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>
