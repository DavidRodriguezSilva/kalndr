---
import { SITIO, ruta } from "@/seo/sitio";
import { anioActual } from "@/domain/festivos";

const anio = anioActual();

/**
 * La familia. Son proyectos del mismo autor con el mismo principio —hacen una
 * cosa, sin cuenta y sin nube— y enlazarlos entre sí es lo único que los hace
 * una familia y no tres repositorios sueltos.
 */
const FAMILIA = [
  {
    nombre: "dark-echo",
    que: "Ambientes sonoros procedurales, offline",
    url: "https://github.com/DavidRodriguezSilva/dark-echo",
  },
  {
    nombre: "dark-owl",
    que: "Dictado de voz a texto, 100% local",
    url: "https://github.com/DavidRodriguezSilva/dark-owl",
  },
];

const DATOS = [
  { nombre: "API en JSON", camino: "/api/" },
  { nombre: `Calendario ${anio} (.ics)`, camino: `/api/v1/festivos/${anio}.ics` },
  { nombre: "llms.txt", camino: "/llms.txt" },
];
---

<footer class="mt-20 border-t border-border">
  <div class="mx-auto w-full max-w-[1600px] px-4 py-12 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="font-mono text-sm font-semibold tracking-[0.14em]">KALNDR</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">
          {SITIO.lema} Las fechas se calculan a partir de la ley, no se copian de otro calendario.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold">Datos</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            DATOS.map((d) => (
              <li>
                <a
                  href={ruta(d.camino)}
                  class="text-muted-foreground transition-colors hover:text-festivo"
                >
                  {d.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold">DarkForest</p>
        <ul class="mt-3 space-y-3 text-sm">
          {
            FAMILIA.map((p) => (
              <li>
                <a href={p.url} class="group block">
                  <span class="font-mono text-muted-foreground transition-colors group-hover:text-festivo">
                    {p.nombre}
                  </span>
                  <span class="mt-0.5 block text-xs text-muted-foreground/70">{p.que}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <p>Código y datos bajo licencia MIT. Úsalos sin pedir permiso.</p>
      <a href={SITIO.repositorio} class="transition-colors hover:text-festivo"> Ver en GitHub </a>
    </div>
  </div>
</footer>
