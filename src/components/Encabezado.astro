---
import { ruta } from "@/seo/sitio";
import { trazoMarca } from "@/seo/marca";

interface Props {
  /** Nombre del tema de temporada activo, si hay alguno. */
  tema?: string;
}

const { tema } = Astro.props;
---

<header class="border-b border-border">
  <div
    class="mx-auto flex w-full max-w-[1400px] items-center justify-between gap-4 px-4 py-3 sm:px-8"
  >
    <a
      href={ruta("/")}
      class="flex items-center gap-2.5 rounded-md transition-opacity hover:opacity-80"
      aria-label="KALNDR — inicio"
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        class="text-festivo"
        aria-hidden="true"
        set:html={trazoMarca(2.1)}
      />
      <span class="font-mono text-base font-semibold tracking-[0.14em]">KALNDR</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-4">
      {
        tema && (
          <span class="hidden text-xs text-muted-foreground sm:inline" title="Tema de temporada">
            {tema}
          </span>
        )
      }

      <nav class="flex items-center gap-1 text-sm" aria-label="Secciones">
        <a
          href={ruta("/vacaciones/")}
          class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          Vacaciones
        </a>
        <a
          href={ruta("/calculadora/")}
          class="hidden rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:block"
        >
          Calculadora de días
        </a>
        <a
          href={ruta("/api/")}
          class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          API
        </a>
      </nav>

      <button
        type="button"
        id="cambiar-esquema"
        class="flex h-10 w-10 items-center justify-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        title="Tema: sistema"
        aria-label="Tema: sistema. Pulsa para cambiar."
      >
        <svg
          class="ico ico-sistema h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="13" rx="2"></rect>
          <path d="M8 21h8M12 17v4"></path>
        </svg>
        <svg
          class="ico ico-claro h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="ico ico-oscuro h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* El icono que se ve es el del modo activo. Se resuelve en CSS para que el
     botón ya muestre lo correcto en la primera pintura, sin esperar al JS. */
  .ico {
    display: none;
  }
  :global([data-esquema="sistema"]) .ico-sistema,
  :global([data-esquema="claro"]) .ico-claro,
  :global([data-esquema="oscuro"]) .ico-oscuro {
    display: block;
  }
</style>

<script is:inline>
  // Vanilla a propósito: el conmutador está en todas las páginas y no vale la
  // pena hidratar React para alternar una clase.
  (function () {
    var boton = document.getElementById("cambiar-esquema");
    if (!boton) return;

    var raiz = document.documentElement;
    var MODOS = ["sistema", "claro", "oscuro"];
    var NOMBRES = { sistema: "sistema", claro: "claro", oscuro: "oscuro" };
    var delSistema = window.matchMedia("(prefers-color-scheme: dark)");

    function leer() {
      try {
        var m = localStorage.getItem("kalndr-esquema");
        return MODOS.indexOf(m) >= 0 ? m : "sistema";
      } catch (e) {
        return "sistema";
      }
    }

    function aplicar(modo) {
      raiz.setAttribute("data-esquema", modo);
      raiz.classList.toggle("dark", modo === "sistema" ? delSistema.matches : modo === "oscuro");
      boton.title = "Tema: " + NOMBRES[modo];
      boton.setAttribute("aria-label", "Tema: " + NOMBRES[modo] + ". Pulsa para cambiar.");
      try {
        localStorage.setItem("kalndr-esquema", modo);
      } catch (e) {}
    }

    boton.addEventListener("click", function () {
      aplicar(MODOS[(MODOS.indexOf(leer()) + 1) % MODOS.length]);
    });

    // Si el modo es "sistema", seguir al sistema cuando cambie de verdad
    // —al anochecer, por ejemplo— sin que haya que recargar.
    delSistema.addEventListener("change", function () {
      if (leer() === "sistema") aplicar("sistema");
    });

    aplicar(leer());
  })();
</script>
